{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["runtimeClassNames", "initdata", "images", "imagePullPolicy", "imagePullSecrets", "magic", "route"],
  "properties": {
    "runtimeClassNames": {
      "type": "object",
      "required": ["coco", "kata"],
      "properties": {
        "coco": {"type": "string", "minLength": 1},
        "kata": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "initdata": {
      "type": "object",
      "properties": {
        "configMapName": {"type": "string"},
        "encoded": {"type": "string"}
      },
      "additionalProperties": false
    },
    "images": {
      "type": "object",
      "required": ["demo", "magicServer"],
      "properties": {
        "demo": {"type": "string", "minLength": 1, "not": {"pattern": ":latest$"}, "pattern": ":.{1,}$"},
        "magicServer": {"type": "string", "minLength": 1, "not": {"pattern": ":latest$"}, "pattern": ":.{1,}$"}
      },
      "additionalProperties": false
    },
    "imagePullPolicy": {"type": "string", "enum": ["Always", "IfNotPresent", "Never"]},
    "imagePullSecrets": {
      "type": "array",
      "items": {"type": "object", "required": ["name"], "properties": {"name": {"type": "string", "minLength": 1}}}
    },
    "magic": {
      "type": "object",
      "required": ["string"],
      "properties": {"string": {"type": "string", "minLength": 8, "maxLength": 4096}},
      "additionalProperties": false
    },
    "route": {
      "type": "object",
      "required": ["host"],
      "properties": {
        "host": {"type": "string", "minLength": 1, "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+$"}
      },
      "additionalProperties": false
    },
    "guest": {
      "type": "object",
      "properties": {
        "vcpus": {"type": "string", "pattern": "^[1-9][0-9]*$"},
        "memory": {"type": "string", "pattern": "^[1-9][0-9]*$"}
      },
      "additionalProperties": false
    },
    "resources": {"type": "object"}
  }
}
