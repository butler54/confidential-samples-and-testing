{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["runtimeClassName", "initdata", "images", "imagePullPolicy", "imagePullSecrets", "storage", "startup", "resources", "security", "keyDelivery"],
  "definitions": {
    "name": {"type": "string", "pattern": "^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$", "maxLength": 253},
    "image": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*(:[A-Za-z0-9][A-Za-z0-9._-]*|@sha256:[a-f0-9]{64})$", "not": {"pattern": ":(latest|stable|main|master|nightly|edge|dev|canary)$"}},
    "quantities": {"type": "object", "required": ["cpu", "memory"], "additionalProperties": {"type": "string", "minLength": 1}},
    "resources": {"type": "object", "additionalProperties": false, "required": ["requests", "limits"], "properties": {"requests": {"$ref": "#/definitions/quantities"}, "limits": {"$ref": "#/definitions/quantities"}}}
  },
  "properties": {
    "runtimeClassName": {"$ref": "#/definitions/name"},
    "initdata": {
      "type": "object", "additionalProperties": false, "required": ["configMapName", "encoded"],
      "properties": {
        "configMapName": {"type": "string", "pattern": "^([a-z0-9]([a-z0-9.-]*[a-z0-9])?)?$", "maxLength": 253},
        "encoded": {"type": "string", "pattern": "^[A-Za-z0-9+/=]*$", "maxLength": 200000}
      }
    },
    "images": {
      "type": "object", "additionalProperties": false, "required": ["storageHelper", "utility"],
      "properties": {"storageHelper": {"$ref": "#/definitions/image"}, "utility": {"$ref": "#/definitions/image"}}
    },
    "imagePullPolicy": {"enum": ["IfNotPresent", "Always", "Never"]},
    "imagePullSecrets": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["name"], "properties": {"name": {"$ref": "#/definitions/name"}}}},
    "storage": {
      "type": "object", "additionalProperties": false, "required": ["size", "storageClass"],
      "properties": {
        "size": {"type": "string", "pattern": "^[1-9][0-9]*(Ki|Mi|Gi|Ti)?$"},
        "storageClass": {"oneOf": [{"type": "null"}, {"$ref": "#/definitions/name"}]}
      }
    },
    "startup": {
      "type": "object", "additionalProperties": false, "required": ["timeoutSeconds"],
      "properties": {"timeoutSeconds": {"type": "integer", "minimum": 1, "maximum": 3600}}
    },
    "resources": {
      "type": "object", "additionalProperties": false, "required": ["application", "storageHelper", "utility"],
      "properties": {"application": {"$ref": "#/definitions/resources"}, "storageHelper": {"$ref": "#/definitions/resources"}, "utility": {"$ref": "#/definitions/resources"}}
    },
    "security": {
      "type": "object", "additionalProperties": false, "required": ["sccBinding"],
      "properties": {"sccBinding": {
        "type": "object", "additionalProperties": false, "required": ["create", "name"],
        "properties": {"create": {"type": "boolean"}, "name": {"$ref": "#/definitions/name"}}
      }}
    },
    "keyDelivery": {
      "type": "object", "additionalProperties": false, "required": ["mode", "resourcePath", "secret"],
      "properties": {
        "mode": {"enum": ["curl", "sealed", "insecureSecret"]},
        "resourcePath": {"type": "string", "pattern": "^[A-Za-z0-9_-]+/[A-Za-z0-9_-]+/[A-Za-z0-9_-]+$", "maxLength": 256},
        "secret": {
          "type": "object", "additionalProperties": false, "required": ["name", "key"],
          "properties": {
            "name": {"type": "string", "pattern": "^([a-z0-9]([a-z0-9.-]*[a-z0-9])?)?$", "maxLength": 253},
            "key": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$", "maxLength": 253}
          }
        }
      },
      "if": {"properties": {"mode": {"const": "curl"}}},
      "then": {"properties": {"secret": {"properties": {"name": {"const": ""}}}}},
      "else": {"properties": {"secret": {"properties": {"name": {"minLength": 1}}}}}
    }
  }
}
