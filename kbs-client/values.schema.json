{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["runtimeClassName", "initdata", "images", "imagePullPolicy", "imagePullSecrets", "kbs"],
  "properties": {
    "runtimeClassName": {"type": "string", "minLength": 1},
    "initdata": {
      "type": "object",
      "properties": {
        "configMapName": {"type": "string"},
        "encoded": {"type": "string"}
      },
      "additionalProperties": false
    },
    "images": {
      "type": "object",
      "required": ["client"],
      "properties": {
        "client": {"type": "string", "minLength": 1, "not": {"pattern": ":latest$"}, "pattern": ":.{1,}$"}
      },
      "additionalProperties": false
    },
    "imagePullPolicy": {"type": "string", "enum": ["Always", "IfNotPresent", "Never"]},
    "imagePullSecrets": {
      "type": "array",
      "items": {"type": "object", "required": ["name"], "properties": {"name": {"type": "string", "minLength": 1}}}
    },
    "kbs": {
      "type": "object",
      "properties": {
        "address": {"type": "string"}
      },
      "additionalProperties": false
    },
    "resources": {"type": "object"}
  }
}
